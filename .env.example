# Generate a unique value with at least 32 random bytes. Never reuse a site HMAC secret.
HYDRO_LEAGUE_ADMIN_TOKEN=replace-with-a-unique-random-admin-token-of-at-least-32-bytes
# Optional read-only ICPC Live access. Unset/empty disables /api/live.
# Use a separate random value; never reuse an admin token or school HMAC secret.
HYDRO_LEAGUE_BROADCAST_TOKEN=
HYDRO_LEAGUE_DELAYED_AFTER_MS=45000
HYDRO_LEAGUE_OFFLINE_AFTER_MS=180000
